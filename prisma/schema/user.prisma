model User {
  id            String     @id @default(cuid())
  /// Globally unique authenticated identity
  email         String     @unique
  username      String
  password      String
  userType      UserType   @default(MEMBER)
  status        UserStatus @default(ACTIVE)
  avatar        String?
  emailVerified Boolean    @default(false)

  workspaceId String
  workspace   Workspace @relation("WorkspaceUsers", fields: [workspaceId], references: [id], onDelete: Cascade)

  /// Inverse of Workspace.owner — set only for the OWNER user
  ownedWorkspace Workspace? @relation("WorkspaceOwner")

  // Auth fields
  googleId String? @unique

  /// [MfaSettingsType]
  mfaSettings Json?

  /// [OtpSettingsType]
  otp Json?

  /// [PasswordResetSettingsType]
  passwordReset Json?

  // RBAC: roles assigned to this user (workspace-scoped)
  roles             Role[]
  customPermissions String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([username, workspaceId])
  @@index([workspaceId])
  @@index([userType])
  @@index([status])
}
