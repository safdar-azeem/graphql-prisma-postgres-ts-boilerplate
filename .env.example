# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=boilerplate
DATABASE_URL="postgresql://postgres:password@localhost:5432/boilerplate?schema=public"

# Sharding (optional — omit for single DATABASE_URL mode)
# SHARD_COUNT=3
# SHARD_1_URL="postgresql://postgres:password@localhost:5432/shard1?schema=public"
# SHARD_2_URL="postgresql://postgres:password@localhost:5432/shard2?schema=public"
# SHARD_3_URL="postgresql://postgres:password@localhost:5432/shard3?schema=public"
# SHARD_ROUTING_STRATEGY=modulo
# SHARD_POOL_SIZE=10
# SHARD_IDLE_TIMEOUT_MS=10000
# SHARD_CONNECTION_TIMEOUT_MS=5000
# SHARD_HEALTH_CHECK_INTERVAL_MS=30000
# SHARD_CIRCUIT_BREAKER_THRESHOLD=3
# SHARD_STUDIO_BASE_PORT=51212
# SHARD_CLI_VERBOSE=false
# SHARD_STRICT_DRIFT=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_TLS=false
# REDIS_TLS_INSECURE=false
# REDIS_REQUIRED=false

# Application
PORT=4200
NODE_ENV=development
APP_NAME=AppName
FRONTEND_URL=http://localhost:4202
STORAGE_SERVICE_URL=http://localhost:4201
ENABLE_LOGGER=true
LOG_LEVEL=debug
TRUST_PROXY=false
BODY_LIMIT_BYTES=1000000

# GraphQL security
ALLOW_BATCHED_QUERIES=false
GRAPHQL_QUERY_DEPTH=10

# Queues (opt-in)
ENABLE_QUEUES=false
ENABLE_QUEUE_DASHBOARD=false
# QUEUE_DASHBOARD_TOKEN=use-a-long-random-token

# Security — required at startup (min 32 chars each; must all be distinct)
ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-secret-32+
REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-secret-32+
STORAGE_SERVICE_TOKEN_SECRET=replace-with-a-long-random-storage-secret-32+
STORAGE_SERVICE_TOKEN_ISSUER=boilerplate-storage
STORAGE_SERVICE_TOKEN_AUDIENCE=boilerplate-storage-service
# Legacy JWT_SECRET fallback is development-only and rejected in production:
# JWT_SECRET=replace-with-a-long-random-shared-secret-32+
JWT_ISSUER=boilerplate-api
JWT_AUDIENCE=boilerplate-clients
# Must be exactly 32 characters
MFA_ENCRYPTION_KEY=A9f3K2mQ7Xc8RZL4pWJ6N0H5sD1EYTUb

CORS_ALLOWED_ORIGINS=http://localhost:4202,http://localhost:3000

# Email (optional)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=12345
# SMTP_TLS_INSECURE=false

# Google OAuth (optional)
# GOOGLE_WEB_CLIENT_ID=
