# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/test?schema=public"
SHARD_DIRECTORY_URL="postgresql://postgres:password@localhost:5432/test?schema=public"

# Sharding Configuration
SHARD_COUNT=1
SHARD_1_URL="postgresql://postgres:password@localhost:5432/test?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Application
PORT=4200
NODE_ENV=development
APP_NAME= "AppName"
FRONTEND_URL = "http://localhost:4202"
STORAGE_SERVICE_URL = "http://localhost:4201"

# Comma-separated trusted proxy IP addresses or CIDR ranges. Forwarding headers are ignored by default.
# TRUST_PROXY="127.0.0.1,10.0.0.0/8"

# Security
JWT_SECRET="change-this-to-a-secure-secret-in-production"
# Must be exactly 32 characters
MFA_ENCRYPTION_KEY="A9f3K2mQ7Xc8RZL4pWJ6N0H5sD1EYTUb"

# Token Expiration (Optional config, defaults shown)
# ACCESS_TOKEN_EXPIRES_IN=900 (15m)
# REFRESH_TOKEN_EXPIRES_IN=604800 (7d)


# setup email server
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=12345

# Others
FRONTEND_URL=http://localhost:4202
CORS_ALLOWED_ORIGINS="http://localhost:4202,http://localhost:3000"


# Google 
GOOGLE_WEB_CLIENT_ID = ""
GOOGLE_IOS_CLIENT_ID = ""
GOOGLE_ANDROID_CLIENT_ID = ""
